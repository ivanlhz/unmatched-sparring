{
 "schema": 1,
 "hero": "blackbeard",
 "notes": [
  "Texts read from sheet 2 of the tournament savegame (card images) on 2026-11-22; the hero card is 362 on sheet 3. Restrictions: BLACKBEARD, SEA DOG (Light the Fuse) or ANY.",
  "Rulings: Ivan 2026-11-22 (BB1 the ransom is decided after the target / random card is known and can be paid against an uncancelable card; BB2 'Summon a Sea Dog' returns a defeated one, else Blackbeard may reposition one)."
 ],
 "ability": {
  "text": "PRIVATEER TURNED PIRATE: Start the game with 1 doubloon in the treasury, you have the other 2. At the start of your turn, you may pay 1 doubloon to gain 1 action. When Blackbeard takes combat damage, pay 1 doubloon.",
  "counters": {
   "doubloons": {
    "min": 0,
    "max": 3,
    "start": 2
   },
   "treasury": {
    "min": 0,
    "max": 3,
    "start": 1
   }
  },
  "triggers": [
   {
    "id": "doubloon_action",
    "when": {
     "event": "start_of_turn",
     "player": "owner"
    },
    "condition": {
     "test": "counter",
     "name": "doubloons",
     "min": 1
    },
    "ops": [
     {
      "op": "optional",
      "cost": [
       {
        "op": "counter",
        "name": "doubloons",
        "delta": -1
       },
       {
        "op": "counter",
        "name": "treasury",
        "delta": 1
       }
      ],
      "ops": [
       {
        "op": "gain_action",
        "amount": 1
       }
      ]
     }
    ],
    "notes": "At the start of his turn Blackbeard may pay 1 doubloon (to the Treasury) for 1 action, once. Not offered with no doubloon."
   },
   {
    "id": "doubloon_damage",
    "when": {
     "event": "damage_taken",
     "target": {
      "role": "hero"
     },
     "damage": "combat"
    },
    "condition": {
     "test": "counter",
     "name": "doubloons",
     "min": 1
    },
    "ops": [
     {
      "op": "counter",
      "name": "doubloons",
      "delta": -1
     },
     {
      "op": "counter",
      "name": "treasury",
      "delta": 1
     }
    ],
    "notes": "When BLACKBEARD (not a Sea Dog) takes combat damage he pays 1 doubloon to the Treasury; once per combat damage dealt to him; nothing with no doubloon."
   }
  ],
  "passives": [],
  "notes": "The three doubloons are two counters of Blackbeard's player: `doubloons` (the ones he holds, 2 at the start) and `treasury` (1 at the start); they always add up to 3. A RANSOM ('unless N') is an `optional` of the OPPONENT whose cost moves N doubloons from `treasury` to `doubloons`; the effect line is its `else`, so paying ignores that one line (it does not cancel it, so an uncancelable card is ransomed too). `optional` offers the cost only when the Treasury holds N."
 },
